/* app.wxss */
page {
  background-color: #FFF8F0;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/* 主色调按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.btn-primary::after {
  border: none;
}

/* 次要按钮 */
.btn-secondary {
  background: #fff;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

.btn-secondary::after {
  border: none;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-orange {
  background: #FFF0E8;
  color: #FF6B35;
}

.tag-green {
  background: #E8F5E9;
  color: #4CAF50;
}

.tag-blue {
  background: #E3F2FD;
  color: #2196F3;
}

.tag-gray {
  background: #F5F5F5;
  color: #666;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 价格等级 */
.price-level {
  color: #FF6B35;
  font-size: 24rpx;
}

/* 评分 */
.rating {
  color: #FFC107;
  font-size: 24rpx;
}

/* 安全区域底部填充 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}

<!-- pages/profile/profile.wxml -->
<view class="container">
  <!-- 用户统计卡片 -->
  <view class="stats-card card">
    <view class="stats-header">
      <text class="stats-title">🍽️ 吃货档案</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{totalVisits}}</text>
        <text class="stat-label">总用餐记录</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{favoriteCount}}</text>
        <text class="stat-label">收藏餐厅</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{blacklistCount}}</text>
        <text class="stat-label">黑名单</text>
      </view>
    </view>
  </view>

  <!-- 最近去过 -->
  <view class="section-header">
    <text class="section-label">最近去过</text>
    <text class="section-clear" bindtap="clearHistory">清除记录</text>
  </view>
  <view wx:if="{{recentList.length === 0}}" class="empty-hint">暂无记录</view>
  <view wx:else class="recent-list card">
    <view
      wx:for="{{recentList}}"
      wx:key="id"
      class="recent-item"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <text class="recent-emoji">{{item.emoji}}</text>
      <view class="recent-info">
        <text class="recent-name">{{item.name}}</text>
        <text class="recent-time">{{item.lastVisitText}}</text>
      </view>
      <text class="recent-arrow">›</text>
    </view>
  </view>

  <!-- 偏好设置 -->
  <view class="section-header">
    <text class="section-label">偏好设置</text>
  </view>
  <view class="settings-card card">
    <!-- 最大价格 -->
    <view class="settings-item">
      <text class="settings-label">🏷️ 最高人均价格</text>
      <view class="settings-right">
        <text class="price-value">¥{{preferences.maxPrice}}</text>
      </view>
    </view>
    <view class="settings-slider">
      <text class="slider-min">¥10</text>
      <slider
        class="price-slider"
        min="10"
        max="200"
        step="5"
        value="{{preferences.maxPrice}}"
        activeColor="#FF6B35"
        bindchange="onMaxPriceChange"
      />
      <text class="slider-max">¥200</text>
    </view>

    <view class="divider"></view>

    <!-- 偏好菜系 -->
    <view class="settings-item">
      <text class="settings-label">🥢 偏好菜系</text>
    </view>
    <view class="cuisine-tags">
      <view
        wx:for="{{allCuisineTypes}}"
        wx:key="*this"
        class="cuisine-tag {{preferences.favoriteCuisines.includes(item) ? 'cuisine-tag-active' : ''}}"
        bindtap="toggleCuisine"
        data-cuisine="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 菜系概率配置 -->
  <view class="section-header">
    <text class="section-label">菜系随机概率</text>
    <text class="section-clear" bindtap="resetCuisineWeights">重置</text>
  </view>
  <view class="settings-card card">
    <view class="cuisine-weight-hint">
      <text class="hint-text">调整每个菜系被随机到的概率（%），数值越高越容易被推荐</text>
    </view>
    <view
      wx:for="{{allCuisineTypes}}"
      wx:key="*this"
      class="cuisine-weight-item"
    >
      <view class="cuisine-weight-header">
        <text class="cuisine-weight-name">{{item}}</text>
        <text class="cuisine-weight-value">{{cuisineWeights[item] || 0}}%</text>
      </view>
      <slider
        min="0"
        max="100"
        step="1"
        value="{{cuisineWeights[item] || 0}}"
        activeColor="#FF6B35"
        data-cuisine="{{item}}"
        bindchange="onCuisineWeightChange"
      />
    </view>
  </view>

  <!-- 特殊规则 -->
  <view class="section-header">
    <text class="section-label">🎯 特殊规则</text>
  </view>
  <view class="settings-card card">
    <!-- Burger Day -->
    <view class="settings-item special-rule-item">
      <view class="special-rule-info">
        <text class="special-rule-name">🍔 Burger Day</text>
        <text class="special-rule-desc">每周四将西式快餐随机概率提升到 80%</text>
      </view>
      <switch
        checked="{{specialRules.burgerDay}}"
        color="#FF6B35"
        bindchange="toggleBurgerDay"
      />
    </view>

    <view class="divider"></view>

    <!-- Coffee Time -->
    <view class="settings-item special-rule-item">
      <view class="special-rule-info">
        <text class="special-rule-name">☕ Coffee Time</text>
        <text class="special-rule-desc">10% 概率额外推荐一家咖啡饮料店</text>
      </view>
      <switch
        checked="{{specialRules.coffeeTime}}"
        color="#FF6B35"
        bindchange="toggleCoffeeTime"
      />
    </view>

    <view class="divider"></view>

    <!-- 吃点好的 -->
    <view class="settings-item special-rule-item">
      <view class="special-rule-info">
        <text class="special-rule-name">✨ 吃点好的</text>
        <text class="special-rule-desc">4% 概率无视其他规则，推荐人均 > ¥100 的店铺</text>
      </view>
      <switch
        checked="{{specialRules.eatBetter}}"
        color="#FF6B35"
        bindchange="toggleEatBetter"
      />
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section-header">
    <text class="section-label">数据管理</text>
  </view>
  <view class="settings-card card">
    <view class="settings-item" bindtap="viewBlacklist">
      <text class="settings-label">🚫 黑名单管理</text>
      <view class="settings-right">
        <text class="settings-badge" wx:if="{{blacklistCount > 0}}">{{blacklistCount}}</text>
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="settings-item" bindtap="viewFavorites">
      <text class="settings-label">❤️ 我的收藏</text>
      <view class="settings-right">
        <text class="settings-badge" wx:if="{{favoriteCount > 0}}">{{favoriteCount}}</text>
        <text class="settings-arrow">›</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="settings-item" bindtap="syncRestaurants">
      <text class="settings-label">🔄 同步餐厅数据</text>
      <text class="settings-arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="settings-item danger" bindtap="resetAll">
      <text class="settings-label danger-text">🗑️ 重置所有数据</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about">
    <text class="about-text">OfficeGourmet v1.0</text>
    <text class="about-text">再也不用纠结今天吃什么了 😄</text>
  </view>

  <view class="safe-bottom"></view>
</view>

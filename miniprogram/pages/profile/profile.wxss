/* pages/profile/profile.wxss */

/* 统计卡片 */
.stats-card {
  padding: 32rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
}

.stats-header {
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 区块标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 0 16rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-clear {
  font-size: 24rpx;
  color: #FF6B35;
}

/* 最近去过 */
.empty-hint {
  font-size: 26rpx;
  color: #bbb;
  text-align: center;
  padding: 30rpx 0;
}

.recent-list {
  margin-bottom: 30rpx;
  overflow: hidden;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.recent-info {
  flex: 1;
}

.recent-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.recent-time {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

.recent-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 设置卡片 */
.settings-card {
  margin-bottom: 30rpx;
  overflow: hidden;
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
}

.settings-item.danger {
  background: #FFF5F5;
}

.settings-label {
  font-size: 30rpx;
  color: #333;
}

.danger-text {
  color: #f44336;
}

.settings-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settings-badge {
  background: #FF6B35;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.settings-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 价格滑块 */
.settings-slider {
  display: flex;
  align-items: center;
  padding: 0 28rpx 24rpx;
}

.price-slider {
  flex: 1;
  margin: 0 12rpx;
}

.price-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
}

.slider-min, .slider-max {
  font-size: 22rpx;
  color: #bbb;
}

/* 菜系标签 */
.cuisine-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 28rpx 28rpx;
}

.cuisine-tag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.cuisine-tag-active {
  background: #FFF0E8;
  color: #FF6B35;
  border-color: #FF6B35;
}

/* 关于 */
.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  gap: 8rpx;
}

.about-text {
  font-size: 24rpx;
  color: #ccc;
}

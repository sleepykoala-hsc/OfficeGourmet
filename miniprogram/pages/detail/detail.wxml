<!-- pages/detail/detail.wxml -->
<view class="container" wx:if="{{restaurant}}">
  <!-- 餐厅头部 -->
  <view class="detail-hero card">
    <view class="hero-emoji-wrap">
      <text class="hero-emoji">{{restaurant.emoji}}</text>
    </view>
    <view class="hero-content">
      <text class="hero-name">{{restaurant.name}}</text>
      <view class="hero-meta">
        <text class="hero-category tag tag-orange">{{restaurant.category}}</text>
        <text class="hero-cuisine">{{restaurant.cuisine}}</text>
      </view>
      <view class="hero-rating">
        <text class="star-big">★ {{restaurant.rating}}</text>
        <text class="rating-count-big">({{restaurant.ratingCount}}条评价)</text>
      </view>
    </view>
  </view>

  <!-- 关键信息行 -->
  <view class="info-grid card">
    <view class="info-item">
      <text class="info-icon">💰</text>
      <text class="info-value">¥{{restaurant.avgPrice}}</text>
      <text class="info-label">人均消费</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <text class="info-icon">📍</text>
      <text class="info-value">{{restaurant.distance}}m</text>
      <text class="info-label">步行距离</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <text class="info-icon">⏰</text>
      <text class="info-value hours-value">{{restaurant.openHours}}</text>
      <text class="info-label">营业时间</text>
    </view>
  </view>

  <!-- 简介 -->
  <view class="section card">
    <text class="section-title">🗒️ 简介</text>
    <text class="section-content description-text">{{restaurant.description}}</text>
  </view>

  <!-- 标签 -->
  <view class="section card">
    <text class="section-title">🏷️ 特色标签</text>
    <view class="tags-wrap">
      <text wx:for="{{restaurant.tags}}" wx:key="*this" class="tag tag-orange">{{item}}</text>
    </view>
  </view>

  <!-- 地址 -->
  <view class="section card">
    <text class="section-title">📌 地址</text>
    <text class="section-content">{{restaurant.address}}</text>
  </view>

  <!-- 上次访问 -->
  <view class="section card" wx:if="{{lastVisitText}}">
    <text class="section-title">🕐 最近一次去</text>
    <text class="section-content">{{lastVisitText}}</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button
      class="action-btn {{isFavorite ? 'action-btn-active' : 'action-btn-secondary'}}"
      bindtap="toggleFavorite"
    >
      {{isFavorite ? '❤️ 已收藏' : '🤍 收藏'}}
    </button>
    <button
      class="action-btn {{isBlacklisted ? 'action-btn-danger' : 'action-btn-secondary'}}"
      bindtap="toggleBlacklist"
    >
      {{isBlacklisted ? '✅ 已从黑名单移除' : '🚫 不想吃'}}
    </button>
    <button class="action-btn action-btn-primary" bindtap="confirmVisit">
      ✅ 就吃这家
    </button>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 404 状态 -->
<view wx:else class="empty container">
  <text class="empty-icon">😅</text>
  <text class="empty-text">找不到该餐厅</text>
</view>

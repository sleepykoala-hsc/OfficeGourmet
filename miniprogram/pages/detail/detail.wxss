/* pages/detail/detail.wxss */

/* 英雄区域 */
.detail-hero {
  display: flex;
  padding: 32rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.hero-emoji-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FFF0E8, #FFD6C0);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.hero-emoji {
  font-size: 72rpx;
}

.hero-content {
  flex: 1;
}

.hero-name {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.hero-category {
  font-size: 24rpx;
}

.hero-cuisine {
  font-size: 24rpx;
  color: #666;
}

.hero-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.star-big {
  font-size: 32rpx;
  color: #FFC107;
  font-weight: 600;
}

.rating-count-big {
  font-size: 22rpx;
  color: #999;
}

/* 信息格子 */
.info-grid {
  display: flex;
  padding: 32rpx;
  margin-bottom: 20rpx;
  justify-content: space-around;
  align-items: center;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.info-icon {
  font-size: 40rpx;
}

.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.hours-value {
  font-size: 22rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

.info-divider {
  width: 1rpx;
  height: 80rpx;
  background: #f0f0f0;
}

/* 信息区块 */
.section {
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.description-text {
  background: rgba(255, 107, 53, 0.05);
  padding: 16rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #FF6B35;
  display: block;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 操作按钮栏 */
.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 0 30rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn-primary {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.action-btn-active {
  background: #FFF0E8;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
}

.action-btn-secondary {
  background: #f8f8f8;
  color: #666;
}

.action-btn-danger {
  background: #FFF0E8;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
}

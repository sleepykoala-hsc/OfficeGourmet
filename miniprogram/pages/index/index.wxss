/* pages/index/index.wxss */

/* 顶部标题 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 2rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 用餐时段切换 */
.meal-tabs {
  display: flex;
  background: #fff;
  border-radius: 50rpx;
  padding: 6rpx;
  margin: 0 0 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.meal-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #999;
  transition: all 0.3s;
}

.meal-tab-active {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

/* 推荐区域 */
.recommend-area {
  margin-bottom: 30rpx;
  min-height: 320rpx;
}

/* 空状态卡片 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #bbb;
  text-align: center;
}

/* 转动动画 */
.spinning-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.spinning-emoji {
  font-size: 100rpx;
  display: block;
  animation: bounce 0.4s ease infinite alternate;
}

.spinning-text {
  font-size: 28rpx;
  color: #FF6B35;
  margin-top: 20rpx;
}

@keyframes bounce {
  from { transform: scale(0.9); }
  to { transform: scale(1.1); }
}

/* 结果卡片 */
.result-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #fff 0%, #FFF8F0 100%);
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-emoji {
  font-size: 70rpx;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
}

.result-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.result-cuisine {
  font-size: 24rpx;
  color: #FF6B35;
  background: #FFF0E8;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.result-dot {
  color: #ccc;
  font-size: 24rpx;
}

.result-price {
  font-size: 24rpx;
  color: #666;
}

.favorite-btn {
  padding: 16rpx;
  font-size: 40rpx;
}

.favorite-active {
  animation: heartbeat 0.3s ease;
}

@keyframes heartbeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 评分 */
.result-rating {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.star-text {
  font-size: 28rpx;
  color: #FFC107;
  letter-spacing: 2rpx;
}

.rating-num {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-left: 8rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
}

/* 标签 */
.result-tags {
  margin-bottom: 20rpx;
}

/* 位置信息 */
.result-footer {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.result-distance,
.result-hours {
  font-size: 24rpx;
  color: #888;
}

.result-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding: 16rpx;
  background: rgba(255, 107, 53, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid #FF6B35;
  margin-bottom: 16rpx;
}

.detail-hint {
  text-align: right;
  font-size: 24rpx;
  color: #FF6B35;
}

/* 操作按钮 */
.action-area {
  margin-bottom: 40rpx;
}

.roll-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  margin-bottom: 20rpx;
  border-radius: 50rpx;
}

.secondary-actions {
  display: flex;
  gap: 20rpx;
}

.secondary-actions button {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.btn-blacklist {
  color: #999 !important;
  border-color: #ddd !important;
}

/* 快速筛选 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.filter-scroll {
  width: 100%;
}

.filter-tags {
  display: flex;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.filter-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  margin-right: 16rpx;
  border: 2rpx solid #eee;
  white-space: nowrap;
}

.filter-tag-active {
  background: #FF6B35;
  color: #fff;
  border-color: #FF6B35;
}
